node_modules/
dist/
dev-dist/
icon-source.png
*.local
.DS_Store

# never commit private signing keys / credentials
*.key
*.pem
.env
.env.*

# extraction pipeline workspace (large unpacked APK content)
tools/extract/_work/
tools/vendor/
tools/extract/.venv/
__pycache__/

# raw move-clip recordings (large 720p source; only transcoded MP4s under
# public/assets/skills are committed). Keep the per-Pokémon MOVES.txt checklists.
tools/community/_clips/*/*.mp4
tools/community/_clips/*/*.MP4
tools/community/_clips/*/*.mov
tools/community/_clips/*/*.MOV

# private in-game tooltip stills — reference only, never distributed.
# Keep per-Pokémon SKILLS.txt checklists and the folder README.
screenshot-references/**
!screenshot-references/
!screenshot-references/move-descriptions/
!screenshot-references/move-descriptions/README.md
!screenshot-references/move-descriptions/*/
!screenshot-references/move-descriptions/*/SKILLS.txt
screenshot-references/**/.DS_Store

# temporary stills-transcription sidecars (never commit)
tools/community/_stills_inbox/
